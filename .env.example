# URL pública del backend (sgn-back). El servidor del sitio la usa de máquina a
# máquina; el navegador del visitante nunca la ve.
SITE_API_URL=http://127.0.0.1:4000

# Secreto compartido con el backend para leer el contenido publicado.
SITE_API_TOKEN=cambiame

# Llave del sitio dentro del backend.
SITE_KEY=golden-bird

# Secreto que el backend usa para avisar que hay contenido nuevo y que este
# sitio tire su caché. Sin esto el cambio aparece igual, cuando vence el TTL.
SITE_REVALIDATE_TOKEN=cambiame
