---
import AboutSection from '../components/sections/about/AboutSection.astro';
import BirdsSection from '../components/sections/birds/BirdsSection.astro';
import CategoryNavigation from '../components/sections/categories/CategoryNavigation.astro';
import ClosingSection from '../components/sections/closing/ClosingSection.astro';
import FoodSection from '../components/sections/food/FoodSection.astro';
import HeroSection from '../components/sections/hero/HeroSection.astro';
import PetsSection from '../components/sections/pets/PetsSection.astro';
import ProductsSection from '../components/sections/products/ProductsSection.astro';
import RecentProductsSection from '../components/sections/products/RecentProductsSection.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { getSiteContent } from '../lib/site-content';

/**
 * El contenido se trae una sola vez por visita y se pasa hacia abajo.
 *
 * Podría pedirlo cada sección por su cuenta, pero entonces una expiración de
 * caché a mitad del render dejaría media página con la versión vieja y media
 * con la nueva. Una sola lectura garantiza que lo que se ve es un estado
 * consistente del sitio.
 */
const content = await getSiteContent();
---

<MainLayout content={content}>
  <main id="contenido" class="bg-paper">
    <HeroSection content={content} />
    <CategoryNavigation content={content} />
    <PetsSection content={content} />
    <AboutSection content={content} />
    <BirdsSection content={content} />
    <FoodSection content={content} />
    <RecentProductsSection content={content} />
    <ProductsSection content={content} />
    <ClosingSection content={content} />
  </main>
</MainLayout>
