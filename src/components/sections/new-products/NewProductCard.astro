---
import type { NewProduct } from "../../../data/home";

interface Props {
  item: NewProduct;
}

const { item } = Astro.props;
---

<article
  class:list={[
    "new-product-card group flex items-center gap-3.5 sm:gap-4 rounded-2xl sm:rounded-[24px] border p-3.5 sm:p-4 transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_28px_#593e2114] bg-white",
    item.accentBorder,
  ]}
>
  <!-- Product Image in Pastel Container -->
  <div
    class:list={[
      "relative size-24 sm:size-28 shrink-0 overflow-hidden rounded-xl sm:rounded-2xl p-2 shadow-xs transition-transform duration-200 group-hover:scale-[1.02] flex items-center justify-center",
      item.accentBg,
    ]}
  >
    <img
      class="size-full object-contain transition-transform duration-300 group-hover:scale-105"
      src={item.image}
      alt={item.name}
      width="200"
      height="200"
      loading="lazy"
    />
  </div>

  <!-- Product Details -->
  <div class="flex flex-1 flex-col justify-center min-w-0">
    <div class="flex items-center justify-between gap-1 mb-1">
      <span class="text-[0.68rem] font-bold tracking-wider text-[#8a552c] uppercase">
        {item.category}
      </span>
      {item.tag && (
        <span class="rounded-full bg-orange/15 px-2 py-0.5 text-[0.65rem] font-black text-orange">
          {item.tag}
        </span>
      )}
    </div>

    <h3 class="font-display text-[1rem] sm:text-[1.08rem] font-black text-ink leading-snug line-clamp-2 transition-colors duration-200 group-hover:text-orange">
      {item.name}
    </h3>

    <p class="mt-1 text-xs text-muted leading-relaxed line-clamp-1">
      {item.description}
    </p>

    <!-- Price row in Quetzales (Q) without star ratings or action buttons -->
    <div class="mt-2.5 flex items-baseline gap-2">
      <span class="font-display text-[1.18rem] sm:text-[1.25rem] font-black text-orange">
        {item.price}
      </span>
      <span class="text-xs font-medium text-muted/75 line-through">
        {item.originalPrice}
      </span>
    </div>
  </div>
</article>
