---
import { accent } from "../../../lib/accents";
import type { ResolvedImage } from "../../../lib/site-content";
import type { SiteFood } from "../../../lib/site-schema";

interface Props {
  item: SiteFood;
  photo: ResolvedImage;
  index: number;
}

const { item, photo } = Astro.props;
const colors = accent(item.accent);
---

<article
  class:list={[
    "food-card group relative flex flex-col justify-between rounded-[28px] border p-4 sm:p-5 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[0_16px_35px_#593e2118] shrink-0 w-[270px] sm:w-[290px] md:w-[310px] snap-start",
    colors.bg,
    colors.border,
  ]}
>
  <div>
    <!-- Top badge row -->
    <div class="mb-3 flex items-center justify-between">
      <span class="rounded-full bg-white/90 px-3 py-1 text-[.7rem] font-bold tracking-wider text-[#8a552c] uppercase shadow-xs">
        {item.kind}
      </span>
      {item.badge && (
        <span class="rounded-full bg-orange px-2.5 py-0.5 text-[.7rem] font-extrabold text-white shadow-xs">
          {item.badge}
        </span>
      )}
    </div>

    <!-- Product Image Container -->
    <div class="product-photo relative aspect-square w-full overflow-hidden rounded-2xl bg-white p-3 shadow-xs transition-transform duration-300 group-hover:scale-[1.01]">
      <img
        class="size-full object-contain transition-transform duration-300 group-hover:scale-105"
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
      />
    </div>

    <!-- Weight / Presentation -->
    <div class="mt-3 flex items-center justify-center">
      <span class="rounded-full bg-white/80 px-2.5 py-0.5 text-[.75rem] font-semibold text-[#8a552c] border border-line/40 shadow-2xs">
        {item.weight}
      </span>
    </div>

    <!-- Product Title -->
    <h3 class="mt-2 text-center font-display text-[1.18rem] leading-snug font-black text-ink">
      {item.name}
    </h3>

    <!-- Description -->
    <p class="mt-1.5 text-center text-xs leading-relaxed text-muted line-clamp-2">
      {item.description}
    </p>
  </div>

  <!-- Price Section -->
  <div class="mt-4 pt-2 flex items-baseline justify-center gap-2">
    <span class="font-display text-[1.4rem] font-black text-orange">
      {item.price}
    </span>
    {item.originalPrice && (
      <span class="text-xs font-medium text-muted/80 line-through">
        {item.originalPrice}
      </span>
    )}
  </div>
</article>
