---
import type { ResolvedImage } from '../../../lib/site-content';
import type { SiteBird } from '../../../lib/site-schema';

interface Props {
  bird: SiteBird;
  photo: ResolvedImage;
  index: number;
}

const { bird, photo, index } = Astro.props;
const cardVariants = [
  'bg-[#fbf1df]',
  'mt-[42px] bg-[#f6e3d7] rounded-[45%_48%_45px_45px/27%_29%_45px_45px] max-[1000px]:rounded-[45%_48%_45px_45px/27%_29%_45px_45px] max-[700px]:mt-0 max-[700px]:justify-self-end max-[700px]:rounded-[45%_48%_45px_45px/27%_29%_45px_45px]',
  'mt-[7px] bg-[#eeeae3] max-[700px]:mt-0',
] as const;
const photoVariants = [
  'rounded-full',
  'rounded-[47%_53%_55%_45%/53%_45%_55%_47%]',
  'rounded-[53%_47%_46%_54%/45%_50%_50%_55%]',
] as const;
---

<article class:list={["bird-card reveal group relative rounded-[160px_160px_45px_45px] px-5 pt-[17px] pb-7 text-center max-[1100px]:px-[15px] max-[1000px]:rounded-[150px_150px_35px_35px] max-[700px]:w-[93%] max-[700px]:max-w-[390px] max-[700px]:justify-self-start max-[700px]:rounded-[160px_160px_38px_38px] max-[700px]:px-[22px] max-[380px]:w-[96%]", cardVariants[index]]}>
  <div class:list={["bird-photo relative mx-auto aspect-square bg-[#e8d9c2] max-[700px]:max-w-[295px]", photoVariants[index]]}>
    <img class="size-full rounded-[inherit] object-cover object-center transition-transform duration-400 group-hover:-rotate-3 group-hover:scale-[1.02]" src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
    <span class="bird-number absolute right-1.5 bottom-1 grid size-[43px] place-items-center rounded-full bg-paper font-display text-sm font-black shadow-[0_3px_10px_#593e2110]">{bird.number}</span>
  </div>
  <div class="bird-title mt-[22px] flex items-center justify-center gap-[11px]"><h3 class="text-[1.75rem] font-black tracking-[-.03em] max-[1000px]:text-2xl max-[700px]:text-[1.7rem]">{bird.name}</h3><span class="text-sm text-orange" aria-hidden="true">✦</span></div>
  <p class="scientific mt-[5px] text-[.8125rem] text-muted italic">{bird.scientific}</p>
  <p class="bird-description mt-4 text-base leading-[1.75] text-[#62574c]">{bird.description}</p>
</article>
