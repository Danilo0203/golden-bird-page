---
import DecorativeSquiggle from '../../common/DecorativeSquiggle.astro';
---

<section class="intro reveal relative mx-auto grid max-w-[1200px] grid-cols-[.7fr_1.5fr] items-center gap-[9%] px-[6%] pt-[65px] pb-[72px] [scroll-margin-top:1rem] max-[1000px]:gap-[7%] max-[700px]:grid-cols-1 max-[700px]:gap-[39px] max-[700px]:px-[7%] max-[700px]:pt-[45px] max-[700px]:pb-[60px] max-[700px]:text-center" id="nosotros">
  <DecorativeSquiggle class="right-[4%] bottom-2.5 w-[88px] -rotate-12 text-gold max-[700px]:right-[7%] max-[700px]:bottom-1.5 max-[700px]:w-[65px]" />
  <div class="intro-logo relative aspect-square w-full max-w-[290px] rounded-full bg-white p-[22px] shadow-[12px_10px_0_#f4debb] before:absolute before:inset-[-12px] before:-rotate-[15deg] before:rounded-full before:border-2 before:border-dashed before:border-gold max-[700px]:w-[180px] max-[700px]:justify-self-center max-[700px]:p-[15px] max-[700px]:shadow-[8px_8px_0_#f4debb] max-[700px]:before:inset-[-9px]">
    <img class="size-full rounded-full object-contain" src="/images/golden-bird-logo.png" alt="Golden Bird — Mascotas y más" width="1254" height="1254" loading="lazy" />
  </div>
  <div class="intro-copy">
    <p class="eyebrow mb-[18px] text-xs leading-[1.8] font-bold tracking-[.14em] text-[#8a552c]">EL MUNDO GOLDEN BIRD</p>
    <h2 class="text-[clamp(2rem,2.9vw,2.65rem)] font-black leading-[1.17] tracking-[-.04em] max-[700px]:text-[2rem]">Una compañía pequeña.<br /><span class="font-display font-black tracking-[-.035em] text-orange">Un lugar enorme en tu vida.</span></h2>
    <p class="mt-[22px] max-w-[560px] text-base leading-[1.85] text-muted max-[700px]:mt-5">En Golden Bird compartimos el gusto por las aves y las mascotas. Reunimos aves, alimentos, jaulas y accesorios para acompañarte en los detalles de cada día.</p>
  </div>
</section>
