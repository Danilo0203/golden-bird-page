---
import DecorativeSquiggle from '../../common/DecorativeSquiggle.astro';
import type { SiteContent } from "../../../lib/site-content";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { closing } = content.document;
---


<section class="closing reveal relative mx-auto max-w-[1100px] px-[6%] pt-[77px] pb-[82px] text-center [scroll-margin-top:1rem] max-[700px]:px-[7%] max-[700px]:pt-[63px] max-[700px]:pb-[56px]">
  <DecorativeSquiggle class="top-[27px] left-[7%] w-20 -rotate-[18deg] text-gold max-[700px]:top-[9px] max-[700px]:left-[8%] max-[700px]:w-16" />
  <p class="eyebrow mb-[18px] text-xs leading-[1.8] font-bold tracking-[.14em] text-[#8a552c]">{closing.eyebrow}</p>
  <h2 class="text-[clamp(2.5rem,4.2vw,4rem)] font-black leading-[1.17] tracking-[-.04em] max-[700px]:text-[2.45rem]">{closing.title.lead}{closing.title.highlight && <><br /><span class="font-display font-black tracking-[-.035em] text-orange">{closing.title.highlight}</span></>}</h2>
</section>
