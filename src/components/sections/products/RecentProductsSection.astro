---
import { accent } from "../../../lib/accents";
import { image, type SiteContent } from "../../../lib/site-content";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { recentProducts } = content.document;
---

{recentProducts.items.length > 0 && (
  <section
    id="productos-recientes"
    aria-labelledby="recent-products-title"
    class="relative mx-auto max-w-[1360px] px-[6%] pt-12 pb-16 max-[700px]:px-[7%] [scroll-margin-top:calc(var(--header-height)+28px)]"
  >
    <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-5">
      <div>
        <span class="mb-1 inline-block text-lg font-black text-orange" aria-hidden="true">彡</span>
        <h2 id="recent-products-title" class="font-display text-[clamp(2rem,3.4vw,3.2rem)] leading-[1.12] font-black tracking-[-.04em] text-ink">
          {recentProducts.title.lead}
          {recentProducts.title.highlight && <><br /><span class="text-orange">{recentProducts.title.highlight}</span></>}
        </h2>
      </div>
      <a href="#productos" class="shrink-0 rounded-full bg-orange px-6 py-3 text-sm font-bold text-white transition-opacity hover:opacity-85 focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-orange">
        Ver productos disponibles <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="reveal grid gap-5 md:grid-cols-2">
      {recentProducts.items.map((product) => {
        const photo = image(content, product.imageId);
        return (
          <article class:list={["recent-product flex min-w-0 items-center gap-4 rounded-[24px] border border-line/60 p-3.5 sm:gap-6 sm:p-5", accent(product.accent).bg]}>
            <div class="flex aspect-square w-[40%] max-w-[185px] shrink-0 items-center justify-center overflow-hidden rounded-[16px] bg-white/85 p-3">
              <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" class="size-full object-contain" />
            </div>
            <div class="min-w-0">
              {product.tag && <p class="mb-2 text-xs font-bold tracking-wide text-orange uppercase">{product.tag}</p>}
              <h3 class="font-display text-lg leading-snug font-black text-ink sm:text-xl">{product.name}</h3>
              <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-display text-xl font-black text-orange sm:text-2xl">{product.price}</span>
                {product.originalPrice && <span class="text-sm text-muted line-through">{product.originalPrice}</span>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
)}
