---
import { accent } from "../../../lib/accents";
import type { ResolvedImage } from "../../../lib/site-content";
import type { SiteProduct } from "../../../lib/site-schema";

interface Props {
  item: SiteProduct;
  photo: ResolvedImage;
}

const { item, photo } = Astro.props;
const colors = accent(item.accent);
---

<article
  class="catalog-item group flex flex-col rounded-[26px] border border-line/75 bg-white p-3.5 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_18px_38px_#593e2118]"
  data-categories={item.categories.join(" ")}
  data-name={item.name}
>
  <!-- Pastel Photo Canvas -->
  <div
    class:list={[
      "relative aspect-square w-full overflow-hidden rounded-[20px] p-4 flex items-center justify-center transition-transform duration-300 group-hover:scale-[1.01]",
      colors.bg,
    ]}
  >
    {item.tag && (
      <span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-0.5 text-[0.68rem] font-bold tracking-wider text-[#8a552c] uppercase shadow-xs backdrop-blur-xs">
        {item.tag}
      </span>
    )}
    <img
      src={photo.src}
      alt={photo.alt}
      class="size-full object-contain transition-transform duration-400 group-hover:scale-105"
      width={photo.width}
      height={photo.height}
      loading="lazy"
    />
  </div>

  <!-- Product Info -->
  <div class="mt-3.5 flex flex-1 flex-col justify-between px-1">
    <h3 class="font-display text-[1.05rem] sm:text-[1.12rem] font-black leading-snug text-ink line-clamp-2 transition-colors duration-200 group-hover:text-orange">
      {item.name}
    </h3>
    <div class="mt-2.5 flex items-baseline gap-2">
      <span class="font-display text-[1.3rem] sm:text-[1.38rem] font-black text-orange">
        {item.price}
      </span>
      {item.originalPrice && (
        <span class="text-xs sm:text-[.8125rem] font-medium text-muted/75 line-through">
          {item.originalPrice}
        </span>
      )}
    </div>
  </div>
</article>
