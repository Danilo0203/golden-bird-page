---
import type { SiteContent } from "../../lib/site-content";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { footer } = content.document;
---

<footer class="flex items-center justify-between gap-5 rounded-t-[55px] bg-charcoal px-[6%] py-[30px] text-white max-[700px]:flex-wrap max-[700px]:gap-4 max-[700px]:rounded-t-[34px] max-[700px]:px-[7%] max-[700px]:py-7">
  <a class="footer-brand font-brand text-[1.7rem] font-semibold focus-visible:outline-[3px] focus-visible:outline-offset-[5px] focus-visible:outline-orange" href="/#inicio">Golden Bird<span class="ml-2.5 text-gold-light">✦</span></a>
  <p class="text-[.8125rem] text-[#d2c8bb]">{footer.tagline}</p>
  <p class="text-[.8125rem] text-[#d2c8bb] max-[700px]:w-full">© {new Date().getFullYear()} Golden Bird</p>
</footer>
